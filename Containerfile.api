# syntax=docker/dockerfile:1
#
# FastAPI API image for generation and monitoring endpoints (#279).
# This is the thin front door that validates requests, stages artifacts,
# enqueues synthesis messages, exposes review/monitoring APIs, and returns
# the stable integration contract response.
#
# Unlike the synthesis runner (Containerfile), this image does NOT need ffmpeg
# — it only handles HTTP and Storage operations. Kept lean for fast cold starts.
#
# Identity-only at runtime: uses managed identity for Blob + Queue access.
FROM python:3.11-slim@sha256:ae52c5bef62a6bdd42cd1e8dffef86b9cd284bde9427da79839de7a4b983e7ca

# Apply security upgrades to the pinned base.
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Non-root runtime user.
RUN groupadd --system api \
    && useradd --system --gid api --home-dir /app --shell /usr/sbin/nologin api

# Install from pyproject.toml (single source of dependency truth). The API only
# needs the core deps — no [video]/[dev] extras — so the image stays lean.
# requirements.lock pins the fully-resolved transitive graph for reproducible
# rebuilds (#599); constraints for unused extras are simply ignored here.
COPY pyproject.toml requirements.lock ./
COPY podcaster ./podcaster
RUN python -m pip install --no-cache-dir --constraint requirements.lock . \
    && python -m pip uninstall -y pip setuptools wheel

USER api

EXPOSE 8000

ENTRYPOINT ["python", "-m", "uvicorn", "podcaster.monitoring:app", "--host", "0.0.0.0", "--port", "8000"]
