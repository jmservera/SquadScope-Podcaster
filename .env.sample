# Environment variables for the ACA synthesis job runner (podcaster.job_runner).
# Copy to .env for local development. Never commit real values.

# Azure identity (use managed identity in production; set AZURE_CLIENT_ID for user-assigned MI).
# For local dev, authenticate with `az login` instead.
# AZURE_CLIENT_ID=

# Storage (Blob + Queue)
PODCASTER_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
PODCASTER_STORAGE_QUEUE_URL=https://<storage-account>.queue.core.windows.net
PODCASTER_STORAGE_CONTAINER=podcaster-artifacts
PODCASTER_SYNTHESIS_QUEUE=synthesis-jobs

# Azure OpenAI (TTS + chat)
AZURE_OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
AZURE_OPENAI_TTS_DEPLOYMENT=tts
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_TTS_VOICE_HOST_A=fable
AZURE_OPENAI_TTS_VOICE_HOST_B=alloy
AZURE_OPENAI_AUTH_MODE=managed_identity

# API key (shared with SquadScope for auth)
PODCASTER_API_KEY=local-dev-key
