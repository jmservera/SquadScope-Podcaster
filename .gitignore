.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Operator-local content (not part of the engine)
*-article.md
podcast-config.json
.podcaster-artifacts/
.test-artifacts*/

# Compiled Bicep output (generated by `az bicep build`)
infra/main.json
.mcp.json
.squad/.cache/
.worktrees/
